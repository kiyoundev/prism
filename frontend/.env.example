# FastAPI backend URL (Railway in production, localhost in dev)
# Server-side only — do NOT prefix with NEXT_PUBLIC_
FASTAPI_URL=https://your-service.up.railway.app

# Shared secret sent as X-API-Key header from the Next.js proxy to FastAPI
# Must match INTERNAL_API_KEY in backend/.env
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=your-secret-key-here
