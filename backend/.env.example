# Supabase (set in Railway environment variables in production)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Shared API key — Next.js proxy sends this as X-API-Key header on every request.
# Generate with: openssl rand -hex 32
# Set the same value in Vercel env vars (INTERNAL_API_KEY) and Railway env vars.
INTERNAL_API_KEY=your-secret-key-here

# CORS — comma-separated list of allowed frontend origins
# Local dev default is http://localhost:3000 (no env var needed)
# Production: set to your Vercel deployment URL(s)
ALLOWED_ORIGINS=https://your-app.vercel.app
